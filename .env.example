# Telegram API Credentials (Required - get from https://my.telegram.org/apps)
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Session Management (Choose ONE)
# Option 1: File-based session (a .session file will be created)
TELEGRAM_SESSION_NAME=telegram_session
# Option 2: String-based session (if you generate one, e.g., using Telethon's string session generator)
TELEGRAM_SESSION_STRING=1231231232erfdfdffd

# HTTP Transport Configuration (Optional - for VPS deployment)
# These are used when running with --http flag
# Default: 0.0.0.0:8000
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8000

# Google OAuth Configuration (Optional - for multi-tenant MCP authentication)
# Get credentials from https://console.cloud.google.com/apis/credentials
# Required when deploying with authentication enabled
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
BASE_URL=http://localhost:8000

# OAuth Persistence (Recommended in production - keeps OAuth state across restarts)
# FASTMCP_JWT_SIGNING_KEY: stable secret for signing JWTs — set once, never rotate
# OAUTH_STORAGE_PATH: directory for encrypted OAuth client/token storage
#   Railway: set to /data/oauth (volume mounted at /data)
#   Local: leave unset (defaults to ./oauth_data)
FASTMCP_JWT_SIGNING_KEY=change-me-to-a-long-random-secret
OAUTH_STORAGE_PATH=/data/oauth

# Optional per-user API key authentication (Neon PostgreSQL).
# When set, clients can authenticate with Authorization: Bearer <api_key>.
# Leave blank to require Google OAuth only.
APIKEY_DATABASE_URL=

# Telegram Session Persistence (Recommended in production - keeps sessions across restarts)
# SESSIONS_STORAGE_PATH: directory for sessions.json
#   Railway: set to /data/sessions (volume mounted at /data)
#   Local: leave unset (defaults to repo root)
SESSIONS_STORAGE_PATH=/data/sessions
